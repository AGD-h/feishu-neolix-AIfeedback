# SerpAPI 搜索接口凭证
# 注意：这里只放变量名，不放真实值
SERPAPI_KEY=

# DeepSeek API 凭证（用于聚类分析）
DEEPSEEK_API_KEY=

# 飞书自建应用凭证
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书多维表格配置
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=
# 多维表格完整链接（打开表格，浏览器地址栏完整复制）
# 用于周报中引导用户打开飞书 AI 问数
BITABLE_URL=

# 飞书群配置（用于周报推送，可选）
FEISHU_CHAT_ID=

# ============================================================
# H5 扫码反馈页（h5/ 目录下 Vite 项目）
#   开发时复制本文件为 h5/.env 后再填真实值；真实值不要提交
# ============================================================
# Vercel Serverless Function 或自建后端的 submit API 根域名（不要带路径，不要末尾 /）
#   例：VITE_FEISHU_API_BASE=https://neolix-h5.vercel.app
VITE_FEISHU_API_BASE=

# 是否调用真实后端：填 "true" = 调 VITE_FEISHU_API_BASE；其他值 = 走本地 Mock simulateAIAnalysis
#   演示前没部署后端时留空即可（默认 Mock，不报错）
VITE_USE_REAL_API=

# 结果页「查看工单处理进度」按钮的跳转链接（多维表格仪表盘 URL）
DASHBOARD_URL=
