# SerpAPI 搜索接口凭证
# 注意：这里只放变量名，不放真实值
SERPAPI_KEY=

# DeepSeek API 凭证（用于聚类分析）
DEEPSEEK_API_KEY=

# 飞书自建应用凭证
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书多维表格配置
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=
# 多维表格完整链接（打开表格，浏览器地址栏完整复制）
# 用于周报中引导用户打开飞书 AI 问数
BITABLE_URL=

# 飞书群配置（用于周报推送，可选）
FEISHU_CHAT_ID=

# ============================================================
# 【P1 新增：AI 路由分派 open_id 池】
#   Python 代码端自动分派工单的处理人（飞书 assigned_to 字段，用户类型=11）
#   规则写在 schema_constants.py ROUTE_RULES_PRIORITY_FIRST（按优先级顺序匹配）
#   获取 open_id 方法：飞书管理后台 → 通讯录 → 点开用户 → URL 里 ou_xxx 或 on_xxx 就是
#
#   ⚠️  不填/填空也完全 OK：写入脚本会自动跳过 assigned_to 字段，行为跟原来 100% 一样
#      （比赛演示时，即使全空，也能在控制台打印「这条应该派给谁」的规则说明用于讲解）
# ============================================================
# ① 安全P0事故主管（优先级最高，不分城市）
ROUTE_SAFETY_P0_OPEN_ID=
# ② 区域运维 P1 团队（按城市匹配，派给当地运维修车）
ROUTE_OPS_BEIJING_OPEN_ID=      # 北京
ROUTE_OPS_SHANGHAI_OPEN_ID=     # 上海
ROUTE_OPS_SHENZHEN_OPEN_ID=     # 广深（深圳+广州）
ROUTE_OPS_EAST_OPEN_ID=         # 华东（杭州+苏州）
ROUTE_OPS_GENERAL_OPEN_ID=      # 通用运维P1池（其余城市兜底）
# ③ C端客服池（投诉 + 体验类，统一派客服）
ROUTE_CS_TEAM_OPEN_ID=
# ④ 产品经理池（建议咨询类，收集给产品迭代）
ROUTE_PRODUCT_TEAM_OPEN_ID=
# ⑤ 兜底分派池（规则都没命中时用，一般填空即可 = 不写assigned_to）
ROUTE_DEFAULT_OPEN_ID=

# ============================================================
# H5 扫码反馈页（h5/ 目录下 Vite 项目）
#   开发时复制本文件为 h5/.env 后再填真实值；真实值不要提交
# ============================================================
# Vercel Serverless Function 或自建后端的 submit API 根域名（不要带路径，不要末尾 /）
#   例：VITE_FEISHU_API_BASE=https://neolix-h5.vercel.app
VITE_FEISHU_API_BASE=

# 是否调用真实后端：填 "true" = 调 VITE_FEISHU_API_BASE；其他值 = 走本地 Mock simulateAIAnalysis
#   演示前没部署后端时留空即可（默认 Mock，不报错）
VITE_USE_REAL_API=

# 结果页「🚀进入飞书AI问数」按钮跳转链接（飞书多维表格完整链接，建议直接复制仪表盘页URL）
#   浏览器打开多维表格 → 选"仪表盘"视图 → 复制地址栏完整URL粘贴进来
#   未配置时按钮自动灰化 + 提示"演示后配置"，不影响跑通
VITE_DASHBOARD_URL=

# 结果页「📊查看本周TOP问题排行榜」按钮跳转链接（聚类周报飞书文档/多维表格TOP问题视图URL）
#   留空 = 默认和 VITE_DASHBOARD_URL 一样；有独立周报链接就单独填
VITE_REPORT_URL=
