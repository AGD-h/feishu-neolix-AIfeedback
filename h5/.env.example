# 是否启用真实 API（调用 Vercel Serverless Function 写入飞书多维表格）
# 开发环境建议设为 false，使用本地 Mock 模式
# 生产环境（Vercel）设为 true
VITE_USE_REAL_API=false

# 飞书 API 基础地址（Vercel 部署时留空，使用同域 /api/submit）
# 本地开发时如需直连，可填写 Vercel 部署域名
VITE_FEISHU_API_BASE=

# 客服联系电话（ErrorPage 连续失败 3 次提示联系人工客服时显示）
# 不填写则"联系客服"卡片自动隐藏（避免展示占位假号）
# 例：VITE_ADMIN_PHONE=400-000-0000
VITE_ADMIN_PHONE=

# 客服微信号（同上，与 VITE_ADMIN_PHONE 至少填一个才会显示联系卡片）
# 例：VITE_ADMIN_WECHAT=Neolix-Support
VITE_ADMIN_WECHAT=

# 飞书多维表格仪表盘完整URL（结果页「进入飞书AI问数」按钮跳转用）
# 需填写完整的 https://... 链接，用户点击后直接打开多维表格AI问数入口
# 例：VITE_DASHBOARD_URL=https://feishu.cn/base/bascnXXXXXXXXX
VITE_DASHBOARD_URL=

# 本周TOP问题排行榜/聚类周报的分享链接（结果页「查看本周TOP问题排行榜」按钮跳转用，可选）
# 不填则按钮显示占位提示「演示后配置」
# 例：VITE_REPORT_URL=https://feishu.cn/docx/doxcnXXXXXXXXX
VITE_REPORT_URL=
